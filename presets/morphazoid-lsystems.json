{
  "documentType": "audiobrain.project",
  "schemaVersion": 1,
  "id": "morphazoid-lsystems",
  "title": "Morphazoid L-Systems",
  "description": "Expand a branch grammar, traverse its geometric frontier, and translate branch encounters into polyphonic notes.",
  "learningGoal": "Keep grammar, turtle geometry, frontier scheduling, note mapping, and synthesis replaceable while one canopy view observes their shared state.",
  "capabilityNotes": [
    "Built-in instruments work without microphone, MIDI, or network permission.",
    "Start Audio explicitly to hear this instrument; audio begins at -18 dB gain.",
    "The graphic observes the shared instrument state and does not drive the audio clock."
  ],
