      "kind": "graph.topology",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "topology": "layered",
        "layers": 4,
        "nodesPerLayer": 3,
        "seed": 17
      }
    },
    {
      "id": "transport",
      "kind": "transport",
      "position": {
        "x": 0,
        "y": 660
      },
      "params": {
        "bpm": 120
      }
    },
    {
