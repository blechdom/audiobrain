      "position": {
        "x": 280,
        "y": 0
      },
      "params": {
        "edgeSeconds": 0.15
      }
    },
    {
      "id": "mapping",
      "kind": "mapping.graphNotes",
      "position": {
        "x": 560,
        "y": 0
      },
      "params": {
        "rootHz": 220,
        "semitonesPerTurn": 12
      }
    },
    {
      "id": "voices",
      "kind": "voice.graph",
      "position": {
        "x": 0,
        "y": 380
      },
      "params": {
        "decay": 0.6
      }
    },
    {
      "id": "gain",
      "kind": "audio.gain",
      "position": {
        "x": 280,
        "y": 380
      },
      "params": {
        "db": -18
      }
    },
    {
      "id": "out",
      "kind": "audio.output",
      "position": {
        "x": 560,
        "y": 380
      },
      "params": {}
    },
    {
      "id": "view",
      "kind": "view.graph",
      "position": {
        "x": 280,
        "y": 660
      },
      "params": {},
      "viewBindings": {
        "edgeTime": {
