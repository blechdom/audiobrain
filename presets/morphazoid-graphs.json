{
  "documentType": "audiobrain.project",
  "schemaVersion": 1,
  "id": "morphazoid-graphs",
  "title": "Morphazoid Graphs",
  "description": "Walk a seeded layered topology; translate vertex encounters into decaying notes while its graph remains visible.",
  "learningGoal": "Distinguish graph-theory topology data from AudioBrain wiring and replace topology, traversal, mapping, and sound independently.",
  "capabilityNotes": [
    "Built-in instruments work without microphone, MIDI, or network permission.",
    "Start Audio explicitly to hear this instrument; audio begins at -18 dB gain.",
    "The graphic observes the shared instrument state and does not drive the audio clock."
  ],
  "nodes": [
