{
  "documentType": "audiobrain.operator-catalog",
  "schemaVersion": 1,
  "status": "implemented",
  "description": "Authoritative AudioBrain operator contracts. The editor, compiler, runtime and public catalog derive from this registry; browser devices require explicit session activation.",
  "limits": {
    "maxNodes": 128,
    "maxEdges": 512,
    "maxWidgets": 64,
    "maxColumns": 24,
    "maxRows": 64
  },
  "signalTypes": [
    {
      "type": "transport.state",
      "schemaVersion": 1,
      "description": "Transport snapshot with beats, BPM, epoch and corresponding host-monotonic time; available when audio is unarmed, not an animation tick."
    },
    {
      "type": "geometry.path",
      "schemaVersion": 1,
      "description": "Bounded geometric paths with stable point/segment identities and coordinate metadata."
    },
    {
      "type": "geometry.features",
      "schemaVersion": 1,
      "description": "Bounded continuous geometric feature frame stamped in host-monotonic seconds with epoch; no musical pitch interpretation."
    },
    {
      "type": "music.voices",
      "schemaVersion": 1,
      "description": "Bounded continuous musical voice controls with stable voice IDs."
    },
    {
      "type": "event.feature",
      "schemaVersion": 1,
      "description": "Bounded timestamped geometric feature-event batch in host-monotonic seconds with epoch."
    },
    {
      "type": "event.note",
      "schemaVersion": 1,
      "description": "Bounded timestamped musical note-event batch in host-monotonic seconds with epoch."
    },
    {
      "type": "geometry.graph",
      "schemaVersion": 1,
      "description": "Bounded graph topology with stable vertex/edge identities."
    },
    {
      "type": "audio.block",
      "schemaVersion": 1,
      "description": "Host-owned runtime audio bus with explicit channel layout; not serialized sample buffers."
    },
    {
      "type": "control.f32",
      "schemaVersion": 1,
      "description": "Finite scalar control/telemetry value with declared meaning and units."
    },
    {
      "type": "text.utf8",
      "schemaVersion": 1,
      "description": "Bounded UTF-8 text; interpreted only by the consuming node contract."
    }
  ],
